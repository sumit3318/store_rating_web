# Copy this file to ".env" and fill in your own values. Never commit ".env".
PORT=5000

# Use a separate MySQL user for the app, not root (see README, "Create a separate MySQL user").
DB_HOST=localhost
DB_PORT=3306
DB_USER=store_app_user
DB_PASSWORD=put_the_password_of_that_mysql_user_here
DB_NAME=store_rating

# A long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=1d

CLIENT_ORIGIN=http://localhost:5173
